NOEMA_DATA_DIR=.data
NOEMA_TIMEZONE=Asia/Jakarta
NOEMA_OWNER_EMAIL=tim@example.com
NOEMA_OWNER_PASSWORD=replace-on-first-local-run
# Optional RFC 6238 base32 secret; enabling it requires an authenticator code at login.
NOEMA_TOTP_SECRET=
NOEMA_ENCRYPTION_KEY=
NOEMA_GOOGLE_CLIENT_ID=
NOEMA_GOOGLE_CLIENT_SECRET=
NOEMA_GOOGLE_REDIRECT_URI=https://noema.example.com/api/v1/integrations/google/callback
NOEMA_GOOGLE_LOGIN_REDIRECT_URI=https://noema.example.com/api/v1/auth/google/callback
NOEMA_VAPID_PUBLIC_KEY=
NOEMA_VAPID_PRIVATE_KEY=
NOEMA_VAPID_SUBJECT=mailto:admin@example.com
NOEMA_CODE_DIR=.
NOEMA_SAVED_CODE_DIR=~/Documents/mycode/snippets
NOEMA_COMPILER_ENABLED=false
NOEMA_COMPILER_ISOLATE=true
NOEMA_COMPILER_CGROUPS=false
NOEMA_COMPILER_MEMORY_LIMIT_BYTES=268435456
NOEMA_COMPILER_CPU_QUOTA_PERCENT=50
NOEMA_CODEX_ENABLED=false
GEMINI_API_KEY=
NOEMA_GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
NOEMA_OPENAI_FAST_MODEL=chat-latest
NOEMA_OPENAI_REASONING_MODEL=gpt-5.6
NOEMA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NOEMA_AI_FAST_CHAIN=
NOEMA_AI_BALANCED_CHAIN=
NOEMA_AI_QUALITY_CHAIN=
NOEMA_AI_TIMEOUT_MS=15000
NOEMA_AI_CAPTURE_MAX_INPUT_CHARS=24000
NOEMA_AI_CAPTURE_MAX_OUTPUT_TOKENS=2000
NOEMA_AI_CAPTURE_MAX_VAULT_FOLDERS_CHARS=4000
NOEMA_WORKER_POLL_MS=1000
DEEPSEEK_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
OPENROUTER_API_KEY=
NOEMA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Defaults to OpenRouter's free-model router for every AI profile.
NOEMA_OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
NOEMA_GROQ_BASE_URL=https://api.groq.com/openai/v1
NOEMA_GROQ_MODEL=llama-3.1-8b-instant
NOEMA_BACKUP_KEY=
NOEMA_BACKUP_RETENTION=14
NOEMA_MIN_FREE_BYTES=1073741824

NOEMA_TOTP_SECRET=
NOEMA_ENCRYPTION_KEY=
NOEMA_GOOGLE_CLIENT_ID=
NOEMA_GOOGLE_CLIENT_SECRET=
NOEMA_GOOGLE_REDIRECT_URI=https://noema.example.com/api/v1/integrations/google/callback
NOEMA_VAPID_PUBLIC_KEY=
NOEMA_VAPID_PRIVATE_KEY=
NOEMA_VAPID_SUBJECT=mailto:admin@example.com
NOEMA_CODE_DIR=.
NOEMA_COMPILER_ENABLED=false
NOEMA_COMPILER_ISOLATE=true
NOEMA_COMPILER_CGROUPS=false
NOEMA_COMPILER_MEMORY_LIMIT_BYTES=268435456
NOEMA_COMPILER_CPU_QUOTA_PERCENT=50
NOEMA_CODEX_ENABLED=false
GEMINI_API_KEY=
NOEMA_GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
NOEMA_OPENAI_FAST_MODEL=chat-latest
NOEMA_OPENAI_REASONING_MODEL=gpt-5.6
NOEMA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

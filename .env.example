LIFEOS_ENCRYPTION_KEY=
LIFEOS_GOOGLE_CLIENT_ID=
LIFEOS_GOOGLE_CLIENT_SECRET=
LIFEOS_GOOGLE_REDIRECT_URI=https://lifeos.example.com/api/v1/integrations/google/callback
LIFEOS_VAPID_PUBLIC_KEY=
LIFEOS_VAPID_PRIVATE_KEY=
LIFEOS_VAPID_SUBJECT=mailto:admin@example.com
LIFEOS_CODE_DIR=.

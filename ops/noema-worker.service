[Unit]
Description=Noema worker
After=noema.service

[Service]
Type=simple
User=noema
Group=noema
WorkingDirectory=/opt/noema
EnvironmentFile=/etc/noema.env
ExecStart=/usr/bin/npm run worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/noema

[Install]
WantedBy=multi-user.target

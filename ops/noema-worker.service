[Unit]
Description=Noema worker
After=noema.service

[Service]
Type=simple
User=noema
Group=noema
WorkingDirectory=/opt/noema
EnvironmentFile=/etc/noema.env
Environment="NODE_OPTIONS=--max-old-space-size=512"
ExecStart=/usr/bin/npm run worker
Restart=on-failure
MemoryMax=384M
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/noema

[Install]
WantedBy=multi-user.target

{
  "name": "noema",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env.local server/worker.mjs",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "npm run test:backend && npm run test:frontend",
    "test:backend": "node --test --test-concurrency=1 test/backend.test.js test/capture-vault.test.js",
    "test:frontend": "node --test test/frontend.test.js",
    "test:experimental": "node --test test/experimental.frontend.test.js",
    "test:browser": "playwright test test/browser/00-capture.spec.ts && playwright test test/browser/01-release.spec.ts --grep \"mobile primary actions respect hierarchy\"",
    "test:browser:all": "playwright test",
    "backup": "node scripts/backup.mjs",
    "verify:backup": "node scripts/verify-backup.mjs",
    "import:v1": "node scripts/import-v1.mjs",
    "sync:obsidian": "node scripts/sync-obsidian.mjs"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "katex": "^0.18.1",
    "next": "^16.3.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rrule": "^2.8.1",
    "tar-stream": "^3.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/tar-stream": "^3.1.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "typescript": "^5.8.3"
  }
}
